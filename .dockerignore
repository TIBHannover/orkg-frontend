# VCS
.git
.gitignore

# Dependencies (installed inside the image)
node_modules
npm-debug.log

# Widget sources are needed (the image runs `npm run widget:build`); only drop
# local leftovers: the dev-server output and stale pre-esbuild node_modules
widget/node_modules
widget/dist

# Build outputs, caches and reports
.next
public/storybook
coverage
junit.xml
.npm

# Local env files (env vars are injected at runtime, never baked into the image)
.env*

# Coding-agent and local working files (can grow very large)
.vscode
.claude
.worktrees
.playwright-cli
screenshots
CLAUDE.md
CLAUDE.local.md
AGENTS.md
